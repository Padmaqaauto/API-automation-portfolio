{
  "petByIdPost": {
    "url": "/pet/{petId}",
    "method": "POST",
    "version": "v2",
    "headers": {
      "Accept": "static:application/json",
      "Content-Type": "static:application/x-www-form-urlencoded"
    },
    "formData": {
      "name": "{petName}",
      "status": "{petStatus}"
    }
  }
}
